# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Environment / secrets
.env
*.session
# Telethon's SQLite rollback journal for the session file above - a transient
# artifact left behind when a fetch.py run is killed mid-transaction (e.g. a
# timeout) rather than exiting cleanly; *.session alone doesn't match this
# suffixed variant. Found untracked on 2026-10-02 after the day's hung/killed
# fetch run - not itself a security-sensitive file like *.session, just never
# meant to be versioned either.
*.session-journal

# Raw data (PDFs too heavy for git)
data/raw/*
!data/raw/.gitkeep

# Local ingestion tracking DB and derived extraction output (regenerable from data/raw/)
data/processed/tracker.db
data/processed/extracted/

# One-off script build output (regenerable from scripts/build_background_doc.py,
# scripts/biweekly_stage1_dryrun.py, etc.)
scripts/output/*.pdf
scripts/output/*.html
scripts/output/*.json
scripts/output/*.md

# Unattended daily-autorun state (scripts/daily_autorun.py) - local machine
# state only, never shared/synced: failure counters, run-quota config, logs,
# and the kill-switch/pause flags.
automation_state/
.pause_automation
