# Copy this file to .env and fill in real values. .env is gitignored.

# From https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# From https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# scripts/daily_autorun.py's end-of-run email alerts (Gmail SMTP). Requires
# 2-Step Verification on the Google account, then an App Password from
# https://myaccount.google.com/apppasswords - NOT the regular account
# password. AUTOMATION_ALERT_TO defaults to AUTOMATION_GMAIL_ADDRESS itself
# if left blank (set it separately only if alerts should go elsewhere).
AUTOMATION_GMAIL_ADDRESS=
AUTOMATION_GMAIL_APP_PASSWORD=
AUTOMATION_ALERT_TO=

# cf-analytics/ (Cloudflare Worker + D1 deploy) - from the Cloudflare dashboard:
# My Profile -> API Tokens -> Create Token -> Custom Token, with Account-level
# "Workers Scripts: Edit" and "D1: Edit" permissions. CLOUDFLARE_ACCOUNT_ID is
# shown on the dashboard's main Overview page sidebar (not a secret itself, kept
# here for consistency). See cf-analytics/README.md for the deploy steps.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
